# HRMS 部署环境变量模板
#
# 使用方法：
#   cd deploy
#   cp .env.example .env
#   编辑 .env，填入真实密码（.env 已被 .gitignore 排除，不会进入版本库）
#
# 注意：请勿把真实密码提交到仓库；生产环境务必使用强密码。

# ===== MySQL =====
# root 密码（必填）
MYSQL_ROOT_PASSWORD=change-me-root
# 数据库名
MYSQL_DATABASE=continew_admin
# 业务库账号
MYSQL_USER=hrms
# 业务库密码（必填）
MYSQL_PASSWORD=change-me-hrms

# ===== Redis =====
# Redis 密码（未设置密码时留空）
REDIS_PASSWORD=

# ===== 前端访问地址 =====
# 生产环境填实际访问地址（用于跨域放行与第三方登录回调）
PROJECT_URL=http://your-server-ip:39000

# ===== 构建上下文 =====
# 项目根目录（docker-compose.yml 位于 deploy/ 下，默认取上一级）
HRMS_PROJECT_DIR=..
